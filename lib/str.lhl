


fn isdigit(char)
{
    return (('0' - 1) < char) & (('9' + 1) > char);
}


fn strdiff(yin, yang)
{
    i = 0;
    lab loop;
        jump done ~ (yin : i) != (yang : i);
        jump done ~ (yin : i) == 0;

        i = i + 1;
        jump loop;
    lab done;

    return ((yin : i) - (yang : i));
}



fn strqtob(str)
{
    i = 0;

    lab loop;
        char = str : i;
        (str + i) : 0 = char;
        jump done ~ char == '\0';

        i = i + 1;
        jump loop;
    lab done;
}

fn strnbtoq(str, null_index)
{
    i = null_index;

    lab loop;
        char = ((str + i) : 0) & 255;
        str : i = char;
        jump done ~ i == 0;

        i = i - 1;
        jump loop;
    lab done;
}

