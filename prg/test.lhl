
use "lib/debug.lhl"

struct entires[100]
{
    number
}

fn compute_entry(index)
{
    entires[index]number = 
        entires[index - 1]number +
        entires[index - 2]number ;
}

fn compute_all()
{
    entires[0]number = 1;
    entires[1]number = 1;

    index = 2;
    lab loop;
        compute_entry(index);

        printd(index);
        index = index + 1;
    jump loop ~ index < 5000;
}

fn main()
{
    compute_all();
}

